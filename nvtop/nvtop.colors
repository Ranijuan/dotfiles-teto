# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #130c0c
selected_bg = #221716
header_bg = #302221

# Text colors
text = #f9e0dd
selected_text = #f9b6b0
header_text = #bca6a4
inactive_text = #84716f

# GPU utilization colors (gradient from low to high)
gpu_util_low = #ffd8c4
gpu_util_med = #ffede9
gpu_util_high = #ff9796

# Memory usage colors
memory_low = #ffdb94
memory_med = #f2b2f2
memory_high = #ffa1c0

# Temperature colors (cool to hot)
temp_cool = #ffd8c4
temp_warm = #ffede9
temp_hot = #ff9796

# Power usage colors
power_low = #ffd8c4
power_med = #ffbeb2
power_high = #f9aaa7

# Process list colors
process_normal = #f9e0dd
process_highlight = #f9b6b0
process_killed = #ff9796

# Border and separator colors
border = #84716f
separator = #554442

# Chart and graph colors
chart_line = #ffddb7
chart_fill = #221716

# Status indicators
status_ok = #ffd8c4
status_warning = #ffede9
status_error = #ff9796
status_info = #ffa1c0
