ope":"resource"},"pythonPreview.hideCode":{"type":"boolean","default":false,"description":"Hide the code display.","scope":"resource"},"pythonPreview.codAndNavWidth":{"type":"number","default":510,"description":"Set code and navigation area width.","scope":"resource"},"pythonPreview.allowAllModules":{"type":"boolean","default":true,"description":"Set whether all modules can be imported.","scope":"resource"},"pythonPreview.maxExecutedLines":{"type":"number","default":1000,"description":"Set the max number of executed lines, in order to against infinite loops.","scope":"resource"},"pythonPreview.cumulativeMode":{"type":"boolean","default":true,"description":"Display all stack frames that have ever exited rather than only currently on the stack.","scope":"resource"},"pythonPreview.trace":{"type":"string","enum":["off","verbose"],"default":"off","description":"Enable debug logging for the python-preview extension.","scope":"window"},"pythonPreview.fontFamily":{"type":"string","default":"verdana, arial, helvetica, sans-serif","description":"Control the font family used in the python preview.","scope":"resource"},"pythonPreview.fontSize":{"type":"number","default":16,"description":"Control the font size in pixels used in the python preview.","scope":"resource"},"pythonPreview.langDisplay.fontFamily":{"type":"string","default":"verdana, arial, helvetica, sans-serif","description":"Control the font family used in the lang display area.","scope":"resource"},"pythonPreview.langDisplay.fontSize":{"type":"string","default":14,"description":"Control the font size in pixels used in the lang display area.","scope":"resource"},"pythonPreview.code.fontFamily":{"type":"string","default":"Andale mono, monospace","description":"Control the font family used in the code display area.","scope":"resource"},"pythonPreview.code.fontSize":{"type":"string","default":15,"description":"Control the font size in pixels in the code display area.","scope":"resource"},"pythonPreview.code.lineHeight":