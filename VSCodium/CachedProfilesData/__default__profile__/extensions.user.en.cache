-mode production --config-name extension:node --env analyzeBundle --env quick","analyze:bundle:extension:web":"webpack --mode production --config-name extension:webworker --env analyzeBundle --env quick","analyze:bundle:webviews":"webpack --mode production --config-name webviews:common --config-name webviews --env analyzeBundle --env quick","analyze:deps":"webpack --env analyzeDeps","benchmark":"node ./scripts/runBenchmark.mjs","benchmark:list":"node ./scripts/runBenchmark.mjs --list","benchmark:graph:bundle":"pnpm run analyze:bundle:webviews && node ./scripts/checkGraphBundle.mjs --json out/perf/graph-bundle.json","benchmark:graph:bundle:check":"node ./scripts/checkGraphBundle.mjs --json out/perf/graph-bundle.json","benchmark:graph:bundle:update":"pnpm run bundle:stats && node ./scripts/checkGraphBundle.mjs --update","benchmark:graph:browser":"playwright test -c tests/e2e/playwright.config.ts tests/e2e/specs/graphPerformance.test.ts --project=vscode --workers=1 --retries=0 --repeat-each=5 --grep @performance && node ./scripts/aggregateGraphBrowserPerformance.mjs","benchmark:graph:engine:compare":"node ./scripts/compareGraphPerformance.mjs","build":"node ./scripts/build.mjs","build:quick":"node ./scripts/build.mjs --quick","build:extension":"node ./scripts/build.mjs --build=extension","build:extension:node":"node ./scripts/build.mjs --build=extension --target=node","build:extension:web":"node ./scripts/build.mjs --build=extension --target=webworker","build:e2e-runner":"esbuild tests/e2e/runner/src/index.ts --bundle --outfile=tests/e2e/runner/dist/index.js --platform=node --external:vscode --format=cjs","build:tests":"node ./scripts/build.mjs --build=unit-tests","build:webviews":"node ./scripts/build.mjs --build=webviews","build:webviews:quick":"node ./scripts/build.mjs --build=webviews --quick","build:icons":"pnpm run icons:svgo && pnpm fantasticon && pnpm run icons:apply && pnpm run icons:export","build:packages":"tsc -b packages/ipc packages/git packages/git-cli packages/plus/git-github packages/plus/integrations packages/plus/ai packages/plus/agents packages/plus/notifications","build:graph-packages":"pnpm -r --filter @gitkraken/commit-graph --filter @gitkraken/commit-graph-ui run build","build:core":"pnpm run build:packages && pnpm --filter @gitkraken/core-gitlens run build","bundle":"node ./scripts/build.mjs --mode production","bundle:analyze":"node ./scripts/build.mjs --mode production --analyzeBundle","bundle:e2e":"node ./scripts/build.mjs --mode production --debug --quick","bundle:quick":"node ./scripts/build.mjs --mode production --quick","bundle:stats":"node ./scripts/build.mjs --mode production --stats","check":"pnpm run check:deps && pnpm run check:colors && oxlint --type-aware --type-check && pnpm run check:l10n","check:deps":"node ./scripts/check-deps.mjs","check:colors":"node ./scripts/check-color-tokens.mjs","check:fix":"oxlint --type-aware --type-check --fix && pnpm run check:deps && pnpm run check:l10n","clean":"pnpm -r run clean && pnpx rimraf --glob dist out .vscode-test .vscode-test-web **/tsconfig*.tsbuildinfo","clean:all":"pnpm run clean && pnpm run clean:deps","clean:deps":"pnpm -r run clean:deps && pnpx rimraf --glob **/node_modules","clean:lint":"pnpm -r run clean:lint && pnpx rimraf --glob **/.stylelintcache **/tsconfig*.tsbuildinfo","copy:images":"webpack --config webpack.config.images.mjs","dev:launch":"node ./scripts/dev-launch.mjs","// Extracts the contributions from package.json into contributions.json":"//","extract:contributions":"node ./scripts/generateContributions.mts --extract","// Generates contributions in contributions.json into package.json":"//","generate:contributions":"node ./scripts/generateContributions.mts","// Generates command types from contributions.json into src/constants.commands.generated.ts":"//","generate:commandTypes":"node ./scripts/generateCommandTypes.mts","generate:customElements":"cem analyze","// Generates docs/telemetry-events.md":"//","generate:docs:telemetry":"node ./scripts/generateTelemetryDocs.mjs","generate:emoji":"node ./scripts/generateEmojiShortcodeMap.mjs","// Generates ThirdPartyNotices.txt":"//","generate:licenses":"node ./scripts/generateLicenses.mjs","fmt":"oxfmt","fmt:check":"oxfmt --check","icons:apply":"node ./scripts/applyIconsContribution.mjs","icons:export":"node ./scripts/export-codicons.mjs","icons:svgo":"svgo -q -f ./images/icons/ --config svgo.config.js","lint:ci":"pnpm run clean:lint && pnpm run check:deps && oxlint --type-aware --type-check -c .oxlintrc.ci.json && pnpm run lint:css && pnpm run lint:css:graph-packages","lint:css":"pnpm run check:colors && stylelint \"src/webviews/apps/**/*.{scss,ts}\" --cache","lint:css:graph-packages":"pnpm --filter @gitkraken/commit-graph --filter @gitlens/components --filter @gitkraken/commit-graph-ui run lint:css","lint:css:fix":"stylelint \"src/webviews/apps/**/*.{scss,ts}\" --cache --fix","pack:core":"pnpm --filter @gitkraken/core-gitlens pack","package":"vsce package --no-dependencies","package-pre":"pnpm run patch-pre && pnpm run package --pre-release","// Packages a second vsix with a fork-neutral README for Open VSX":"//","package-forks":"node ./scripts/packageForks.mjs","patch-pre":"node ./scripts/applyPreReleasePatch.mjs","prep-release":"node ./scripts/prep-release.mjs","prep-core-release":"node ./scripts/prep-core-release.mjs","pub":"vsce publish --no-dependencies","pub-pre":"vsce publish --no-dependencies --pre-release","rebuild":"pnpm run reset && pnpm run build","reset":"pnpm run clean && pnpm install --force","test":"pnpm -r test && vscode-test","test:packages":"pnpm -r --filter \"./packages/**\" run test","test:e2e":"playwright test -c tests/e2e/playwright.config.ts","test:e2e:insiders":"set VSCODE_VERSION=insiders && playwright test -c tests/e2e/playwright.config.ts","verify:graph-packages":"pnpm --filter @gitkraken/commit-graph run verify:package && pnpm --filter @gitkraken/commit-graph-ui run verify:package","update-dts":"pushd \"src/@types\" && pnpx  @vscode/dts dev && popd","update-dts:main":"pushd \"src/@types\" && pnpx  @vscode/dts main && popd","watch":"node ./scripts/build.mjs --watch","watch:quick":"node ./scripts/build.mjs --watch --quick","watch:extension":"node ./scripts/build.mjs --watch --build=extension","watch:tests":"node ./scripts/build.mjs --watch --build=unit-tests","watch:webviews":"node ./scripts/build.mjs --watch --build=webviews","web":"vscode-test-web --extensionDevelopmentPath=. --folder-uri=vscode-vfs://github/gitkraken/vscode-gitlens","web:serve":"node -e \"const p = require('path'); const h = require('os').homedir(); require('child_process').execSync('pnpx  serve --cors -l 5000 --ssl-cert '+p.resolve(h, 'certs/localhost.pem')+' --ssl-key '+p.resolve(h, 'certs/localhost-key.pem'), { stdio: 'inherit' })\"","workflow":"node --experimental-strip-types ./scripts/issues/workflow.mts","pretest":"pnpm run build:tests","vscode:prepublish":"node ./scripts/prepublish.mjs","prepare":"husky","generate:l10n":"node ./scripts/localization.mjs export","check:l10n":"node ./scripts/localization.mjs check","generate:l10n:pseudo":"node ./scripts/localization.mjs pseudo","test:localization":"node --test scripts/__tests__/localization.test.mjs scripts/__tests__/require-format-plural.test.mjs","test:localization:browser":"node --test scripts/__tests__/localization.browser.test.mjs"},"dependencies":{"@awesome.me/webawesome":"catalog:","@configcat/sdk":"1.1.0","@eamodio/supertalk":"0.1.4","@eamodio/supertalk-core":"0.1.4","@eamodio/supertalk-signals":"0.0.7","@gitkraken/commit-graph":"workspace:*","@gitkraken/commit-graph-ui":"workspace:*","@gitkraken/compose-tools":"0.8.1","@gitkraken/conflict-tools":"0.2.3","@gitkraken/provider-apis":"catalog:","@gitkraken/shared-tools":"0.2.0","@gitlens/agents":"workspace:*","@gitlens/ai":"workspace:*","@gitlens/components":"workspace:*","@gitlens/git":"workspace:*","@gitlens/git-cli":"workspace:*","@gitlens/git-github":"workspace:*","@gitlens/integrations":"workspace: