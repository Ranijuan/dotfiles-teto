iew","description":"Provide Preview for Python Execution.","version":"0.0.4","icon":"python-icon.png","author":{"name":"Dong Li","email":"dongli0x00@gmail.com"},"publisher":"dongli","license":"MIT","homepage":"https://github.com/dongli0x00/python-preview","repository":{"type":"git","url":"https://github.com/dongli0x00/python-preview"},"engines":{"vscode":"^1.26.0"},"categories":["Programming Languages","Debuggers"],"keywords":["python","visualizer","preview"],"activationEvents":["onCommand:pythonPreview.showPreview","onCommand:pythonPreview.showPreviewToSide","onCommand:pythonPreview.showLockedPreviewToSide","onCommand:pythonPreview.showSource","onCommand:pythonPreview.refresh","onCommand:pythonPreview.toggleLock","onWebviewPanel:pythonPreview"],"main":"./out/extension","contributes":{"commands":[{"command":"pythonPreview.showPreview","title":"Open Preview","category":"Python Preview","icon":{"light":"./assets/Preview.svg","dark":"./assets/Preview_inverse.svg"}},{"command":"pythonPreview.showPreviewToSide","title":"Open Preview to the Side","category":"Python Preview","icon":{"light":"./assets/PreviewOnRightPane_16x.svg","dark":"./assets/PreviewOnRightPane_16x_dark.svg"}},{"command":"pythonPreview.showLockedPreviewToSide","title":"Open Locked Preview to the Side","category":"Python Preview","icon":{"light":"./assets/PreviewOnRightPane_16x.svg","dark":"./assets/PreviewOnRightPane_16x_dark.svg"}},{"command":"pythonPreview.showSource","title":"Show Source","category":"Python Preview","icon":{"light":"./assets/ViewSource.svg","dark":"./assets/ViewSource_inverse.svg"}},{"command":"pythonPreview.refresh","title":"Refresh Preview","category":"Python Preview","icon":{"light":"./assets/Refresh.svg","dark":"./assets/Refresh_inverse.svg"}},{"command":"pythonPreview.toggleLock","title":"Toggle Preview Locking","category":"Python Preview","icon":{"light":"./assets/ToggleLock.svg","dark":"./assets/ToggleLock_inverse.svg"}}],"menus":{"editor/title":[{"command":"pythonPreview.showP